# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES — Chakwal Guest House
# Set these in Vercel → Project → Settings → Environment Variables (Production),
# then redeploy. This list matches what the code actually reads — after a
# deploy, check Settings → System Health to confirm each one is picked up.
# Never commit real values.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
NEXTAUTH_URL="https://www.staychakwal.de"
COMPANY_ID="company-001"
# PIN that unlocks Finance pages (4 digits)
FINANCE_PIN="REPLACE"

# ─── Cloudinary (staff documents, selfies, images) ────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="cgh_rooms"

# ─── WhatsApp — Meta Cloud API (Zara bot, alerts, guest templates) ─────────────
WHATSAPP_PHONE_NUMBER_ID="REPLACE"
WHATSAPP_API_TOKEN="REPLACE"
# Meta App → Settings → Basic → App secret (verifies incoming webhooks)
WHATSAPP_APP_SECRET="REPLACE"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="REPLACE_WITH_YOUR_CHOSEN_TOKEN"
# Owner's WhatsApp number (manager mode + urgent alerts), e.g. 923001234567
OWNER_WHATSAPP="92XXXXXXXXXX"
# PIN for "/manager <pin>" on WhatsApp (at least 4 characters)
MANAGER_PIN="REPLACE"
# Owner alerts outside Meta's 24h window need an approved UTILITY template
# named "cgh_owner_alert" (English) whose body is exactly: {{1}}

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-REPLACE_WITH_API_KEY"
# REQUIRED for WhatsApp voice notes (Whisper transcription) and guest photos.
# Without it, guests who send a voice note are asked to type instead.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-REPLACE_WITH_OPENAI_KEY"

# ─── Web Push Notifications ───────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="REPLACE_WITH_PUBLIC_VAPID_KEY"
VAPID_PRIVATE_KEY="REPLACE_WITH_PRIVATE_VAPID_KEY"
# Note: the code reads VAPID_EMAIL (not VAPID_SUBJECT)
VAPID_EMAIL="mailto:chakwalguesthouse@gmail.com"

# ─── Scheduled jobs (Vercel Cron) ─────────────────────────────────────────────
CRON_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
