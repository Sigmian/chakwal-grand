# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES — Chakwal Guest House
# Copy this file to .env.production.local and fill in all values.
# Never commit .env.production.local to git.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST:PORT/DATABASE?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
NEXTAUTH_URL="https://chakwalgrand.pk"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="cgh_rooms"

# ─── WhatsApp / Twilio ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="chakwalguesthouse@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Chakwal Guest House <noreply@chakwalgrand.pk>"

# ─── Web Push Notifications ───────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="REPLACE_WITH_PUBLIC_VAPID_KEY"
VAPID_PRIVATE_KEY="REPLACE_WITH_PRIVATE_VAPID_KEY"
VAPID_SUBJECT="mailto:chakwalguesthouse@gmail.com"

# ─── AI Assistant ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-REPLACE_WITH_API_KEY"
