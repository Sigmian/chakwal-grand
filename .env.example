# ============================================================
# .env.local — Environment variables for Chakwal Guest House
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Next.js ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-minimum-32-chars

# ── Database (PostgreSQL) ──────────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/chakwal_grand
# Production: Use Neon.tech, Supabase, or Railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/chakwal_grand

# ── AWS S3 (Image Uploads) ────────────────────────────────────
# Create a bucket at s3.console.aws.amazon.com
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=chakwal-grand-media

# ── Email (Nodemailer) ────────────────────────────────────────
# Use Gmail SMTP or any transactional email service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@chakwalgrand.pk

# ── Business ──────────────────────────────────────────────────
WHATSAPP_NUMBER=923001234567
COMPANY_NAME=Chakwal Guest House Guest House

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_ONLINE_PAYMENTS=false
ENABLE_AI_CHATBOT=false

# ── AI / WhatsApp Bot ─────────────────────────────────────────
# Anthropic Claude — powers Zara (web chat + WhatsApp bot)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# WhatsApp Cloud API (Meta)
# Setup: developers.facebook.com → Create App → Add WhatsApp product
# Free tier: 1,000 conversations/month
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-chosen-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Owner's number: manager mode + urgent alerts. Outside Meta's 24h window alerts
# need an approved UTILITY template "cgh_owner_alert" (English, body: {{1}}).
OWNER_WHATSAPP=923001234567
MANAGER_PIN=change-me

# OpenAI Whisper — required for WhatsApp voice notes (and guest photos).
# Without it, guests who send a voice note are asked to type, and staff get a
# "call them back" push. Settings → System Health shows whether it is set.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ── Push Notifications (VAPID) ────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your@email.com

# ── Google Analytics (optional) ──────────────────────────────
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Cron security — generate with: openssl rand -hex 32
CRON_SECRET=
