# ============================================================
# .env.local — Environment variables for Chakwal Guest House
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Next.js ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-minimum-32-chars

# ── Database (PostgreSQL) ──────────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/chakwal_grand
# Production: Use Neon.tech, Supabase, or Railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/chakwal_grand

# ── AWS S3 (Image Uploads) ────────────────────────────────────
# Create a bucket at s3.console.aws.amazon.com
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=chakwal-grand-media

# ── Email (Nodemailer) ────────────────────────────────────────
# Use Gmail SMTP or any transactional email service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@chakwalgrand.pk

# ── Business ──────────────────────────────────────────────────
WHATSAPP_NUMBER=923001234567
COMPANY_NAME=Chakwal Guest House Guest House

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_ONLINE_PAYMENTS=false
ENABLE_AI_CHATBOT=false

# ── Google Analytics (optional) ──────────────────────────────
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
